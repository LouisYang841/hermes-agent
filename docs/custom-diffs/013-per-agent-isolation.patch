+def _merge_identity_profiles(profiles: list) -> list:
+    """Merge AgentRegistry profiles (from identities.yaml) into the profile list.
+
+    AgentRegistry creates real AgentProfile objects with isolated session DBs,
+    memory directories, workspaces, and role-based toolsets. These are dropped
+    alongside the directory-based profiles so the multi-agent picker sees all
+    running agents.
+    """
+    try:
+        from tools.agent_registry import get_agent_registry
+        reg = get_agent_registry()
+        agent_profiles = reg.list_profiles()
+    except Exception:
+        return profiles
+
+    existing = {p.get("name", "") for p in profiles}
+    for name, ap in agent_profiles.items():
+        if name in existing:
+            continue
+        profiles.append({
+            "name": ap.key,
+            "user_name": ap.user_name,
+            "agent_name": ap.agent_name,
+            "role": ap.role,
+            "path": str(ap.agent_dir),
+            "is_default": bool(ap.role == "owner"),
+            "model": ap.default_model,
+            "provider": ap.default_provider,
+            "has_env": ap.agent_dir.joinpath("config.yaml").exists(),
+            "skill_count": 0,
+        })
+    return profiles
+
