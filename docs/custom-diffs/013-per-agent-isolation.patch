+def _resolve_agent_db(agent_name: str = None):
+    """Resolve SessionDB for a named agent, or shared DB if not specified.
+    
+    Uses AgentRegistry to find the agent's per-agent state.db path.
+    Falls back to the shared SessionDB if AgentRegistry is unavailable
+    or the named agent is not found.
+    """
+    from hermes_state import SessionDB
+    if not agent_name:
+        return SessionDB()
+    try:
+        from tools.agent_registry import get_agent_registry
+        reg = get_agent_registry()
+        profile = reg.get(agent_name)
+        if profile and profile.session_db_path.exists():
+            return SessionDB(db_path=str(profile.session_db_path))
+    except Exception:
+        pass
+    return SessionDB()
+
+
+@app.get("/api/agents")
+async def list_agents():
+    """List all known agent profiles (from identities.yaml + guests)."""
+    try:
+        from tools.agent_registry import get_agent_registry
+        reg = get_agent_registry()
+        profiles = reg.list_profiles()
+        return {"agents": [
+            {"name": name, "role": p.role,
+             "default_model": p.default_model, "default_provider": p.default_provider}
+            for name, p in sorted(profiles.items())
+        ]}
+    except Exception:
+        _log.exception("GET /api/agents failed")
+        return {"agents": []}
+
+
+@app.get("/api/memory")
+async def get_memory(agent: str = None):
+    """Read MEMORY.md and USER.md for a given agent (or shared if not specified)."""
+    try:
+        from pathlib import Path
+        mem_dir = None
+        if agent:
+            try:
+                from tools.agent_registry import get_agent_registry
+                reg = get_agent_registry()
+                profile = reg.get(agent)
+                if profile:
+                    # Per-agent memory is under ~/.hermes/memories/<name>/
+                    mem_dir = Path(profile.agent_dir).parent.parent / "memories" / agent
+            except Exception:
+                pass
+        if not mem_dir or not (mem_dir / "MEMORY.md").exists():
+            # Fall back to shared memory or agent_dir directly
+            hermes_home = Path(os.environ.get("HERMES_HOME", os.path.expanduser("~/.hermes")))
+            mem_dir = hermes_home / "memories" / (agent or "")
+            if not (mem_dir / "MEMORY.md").exists():
+                mem_dir = hermes_home
+
+        def read_file(path):
+            if path.exists():
+                return path.read_text(encoding="utf-8")
+            return ""
+
+        memory_md = read_file(mem_dir / "MEMORY.md")
+        user_md = read_file(mem_dir / "USER.md")
+        return {"memory": memory_md, "user": user_md, "agent": agent}
+    except Exception:
+        _log.exception("GET /api/memory failed")
+        raise HTTPException(status_code=500, detail="Failed to read memory")
+
+
