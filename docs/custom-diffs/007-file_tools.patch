+# ── Workspace enforcement for non-owner users ─────────────────────────────
+def _get_identity_info() -> dict:
+    """Get identity from per-thread threading.local() context.
+
+    Each thread has its own identity via threading.local().
+    Fallback to owner when unset (fail-open: system prompt is the
+    primary gate; code-level identity is defense-in-depth).
+    """
+    try:
+        from tools._identity_context import get_identity
+        ident = get_identity()
+        if ident:
+            return ident
+    except Exception:
+        pass
+    # Fallback: identity stack empty → default to owner
+    # (fail-open: the system prompt already gates non-owner users;
+    #  code-level identity is defense-in-depth, not the primary gate)
+    return {"name": "unknown", "role": "owner"}
+
+
+def _workspace_for(identity_name: str) -> Path:
+    """Return the absolute workspace path for a given identity name."""
+    _home = os.environ.get("HERMES_HOME", str(Path.home() / ".hermes"))
+    return Path(_home) / "workspaces" / identity_name
+
+
+def _check_file_access(path: str) -> str | None:
+    """Return None if access is allowed, or an error string if denied.
+    
+    Owner users have unrestricted access. Non-owner users may only
+    access files within their own workspace directory.
+    """
+    identity = _get_identity_info()
+    role = identity.get("role", "")
+    # If identity file is missing/invalid → allow access (don't lock out)
+    if not role or role == "owner":
+        return None  # Owner or unknown: unrestricted
+
+    name = identity.get("name", "unknown")
+    ws = _workspace_for(name)
+    try:
+        abs_path = Path(path).resolve()
+    except Exception:
+        return f"⛔ 路径无效：{path}"
+
+    if not str(abs_path).startswith(str(ws.resolve())):
+        return (
+            f"⛔ 你没有权限访问该路径。"
+            f"非 owner 用户只能在自己的工作目录内操作文件。"
+        )
+    return None
+
+
